{
  "mcpServers": {
    "smartprescription-codebase": {
      "command": "node",
      "args": ["F:/Project/SmartPrescription/tools/smartprescription-mcp/dist/index.js"],
      "env": {
        "SMARTPRESCRIPTION_ROOT": "F:/Project/SmartPrescription"
      }
    },
    "smartprescription-database": {
      "command": "node",
      "args": ["F:/Project/SmartPrescription/tools/smartprescription-db-mcp/dist/index.js"],
      "env": {
        "SMARTPRESCRIPTION_ROOT": "F:/Project/SmartPrescription",
        "DB_PATH": "DesktopApp/sm/preData.db",
        "DB_READ_ONLY": "false",
        "DB_MAX_ROWS": "500"
      }
    }
  }
}